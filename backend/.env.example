PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google GenAI / Gemini API Access (Phase 3)
# Set your hackathon Gemini API key (NEVER commit this or expose to React frontend)
GEMINI_API_KEY=your_api_key_here

# Isolated Gemma 4 multimodal model identifier provided in hackathon documentation
# (e.g. gemma-4-it or hackathon-specified Gemma 4 endpoint)
GEMMA_MODEL=gemma-4-26b-a4b-it

# CORS Configuration (Phase 6)
# Comma-separated list of allowed frontend origins (supports local development and deployed frontend URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,https://vision-dusky-xi.vercel.app
FRONTEND_ORIGIN=https://vision-dusky-xi.vercel.app
FRONTEND_URL=https://vision-dusky-xi.vercel.app

# Upload & Session Reliability Limits
MAX_UPLOAD_MB=10
SESSION_TTL_SECONDS=1800
MAX_IN_MEMORY_SESSIONS=200
